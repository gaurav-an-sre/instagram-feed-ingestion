# Instagram Graph API Credentials
# Obtain these from https://developers.facebook.com/
INSTAGRAM_APP_ID=your_app_id_here
INSTAGRAM_APP_SECRET=your_app_secret_here
INSTAGRAM_REDIRECT_URI=http://localhost:8000/auth/callback

# Application Settings
DATABASE_URL=sqlite:///./instagram_feed.db
MEDIA_DOWNLOAD_DIR=./media
INGESTION_INTERVAL_MINUTES=30

# Optional: Long-lived access token (if already obtained)
INSTAGRAM_ACCESS_TOKEN=
